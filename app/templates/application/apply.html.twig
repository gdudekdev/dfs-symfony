{% extends 'base.html.twig' %}

{% block title %}Postuler - {{ offer.title }}{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1>Postuler : {{ offer.title }}</h1>
        <p class="text-muted">{{ offer.company }} — {{ offer.contractType }}</p>

        <hr>

        <form method="post">
            <div class="mb-3">
                <label for="cover_letter" class="form-label">Lettre de motivation</label>
                <textarea name="cover_letter" id="cover_letter" class="form-control" rows="8" placeholder="Présentez-vous et expliquez votre motivation..."></textarea>
            </div>

            <button type="submit" class="btn btn-success">Envoyer ma candidature</button>
            <a href="{{ path('app_offer_show', {id: offer.id}) }}" class="btn btn-outline-secondary ms-2">Annuler</a>
        </form>
    </div>
</div>
{% endblock %}
